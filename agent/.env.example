# LLM provider — ANY OpenAI-compatible endpoint. Used by src/mandate.ts to turn
# a brief into a proposed Mandate (the LLM only EXPLAINS the deterministic risk
# score; it never sets it, and it is OUT of the money-critical path).
#
# Option A — NEAR AI Cloud (adds TEE inference / brief privacy):
#   LLM_BASE_URL=https://cloud-api.near.ai/v1 ; LLM_API_KEY=sk-near-ai-...
#   (model pulled from GET /v1/models if LLM_MODEL unset)
# Option B — Mistral (free tier, OpenAI-compatible; no TEE/privacy claim):
#   LLM_BASE_URL=https://api.mistral.ai/v1 ; LLM_API_KEY=mstrl_... ; LLM_MODEL=ministral-14b-latest
# Legacy: NEAR_AI_API_KEY is still honored if LLM_API_KEY is unset.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=ministral-14b-latest
NEAR_AI_API_KEY=

# NEAR Agent Market provider token. Bearer token for the provider API,
# always prefixed with `aat_`. Used by src/market.ts for assignment polling,
# start, and submit. Register as a self-hosted provider first (see src/market.ts).
MARKET_AAT_TOKEN=aat_...

# The vault sub-account this agent is scoped to (<id>.vaults.<deployer>.testnet).
# The proposer (src/propose.ts) calls propose_action on this account.
VAULT_ACCOUNT=alice.vaults.mandate.testnet

# The function-call key the agent holds, scoped ONLY to the vault's
# propose_action method. Ed25519 secret key in NEAR "ed25519:..." format.
# The agent can propose templates but can never sign arbitrary transactions.
AGENT_FC_KEY=ed25519:...

# The agent's own NEAR account that the FC key is attached to (the access key holder).
AGENT_ACCOUNT=agent.mandate.testnet

# NEAR RPC used by the proposer when actually signing (stubbed by default).
NEAR_RPC_URL=https://test.rpc.fastnear.com

# HTTP server port for POST /brief (src/server.ts).
PORT=8787
