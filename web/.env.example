# Data source. Live testnet contracts are the DEFAULT.
# Set NEXT_PUBLIC_MOCK=1 to force the all-mock demo (no network).
# Live-data pages also fall back to mock automatically if an RPC call fails.
NEXT_PUBLIC_MOCK=0
# Agent service base URL (POST /brief). Falls back to mock on failure.
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
# NEAR config
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_COORDINATOR_ID=coordinator.mandate-arthur.testnet
NEXT_PUBLIC_VAULT_ID=demo.vaults.mandate-arthur.testnet
