# Mock mode: render UI without a live chain. Default on.
NEXT_PUBLIC_MOCK=1
# Agent service base URL (POST /brief). Falls back to mock on failure.
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
# NEAR config (used only when NEXT_PUBLIC_MOCK=0)
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_COORDINATOR_ID=coordinator.mandate.testnet
NEXT_PUBLIC_VAULT_ID=demo.vaults.mandate.testnet
